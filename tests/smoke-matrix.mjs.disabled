#!/usr/bin/env node
/**
 * smoke-matrix.mjs — end-to-end smoke against a real Synapse homeserver.
 *
 * v0.1.1 schema: matches what /api/tasks, /api/citizens, /api/events accept
 * on agora central v0.6.0+ (probe 2026-08-28).
 *
 * Usage:
 *   MATRIX_HOMESERVER_URL=https://hs \
 *   MATRIX_USER_ID=@b:hs \
 *   MATRIX_ACCESS_TOKEN=... \
 *   MATRIX_DEVICE_ID=... \
 *   AGORA_SERVER_URL=http://127.0.0.1:18008 \
 *   AGORA_API_TOKEN=... \
 *   node tests/smoke-matrix.mjs
 *
 * Exits non-zero on any failure.
 */

import assert from 'node:assert/strict';

class Skipped extends Error {}

function required(name) {
  const value = process.env[name];
  if (!value) {
    throw new Skipped(`missing env ${name}`);
  }
  return value;
}

const HOMESERVER = required('MATRIX_HOMESERVER_URL');
const USER_ID = required('MATRIX_USER_ID');
const ACCESS_TOKEN = required('MATRIX_ACCESS_TOKEN');
const DEVICE_ID = required('MATRIX_DEVICE_ID');
const AGORA = required('AGORA_SERVER_URL');
const AGORA_TOKEN = required('AGORA_API_TOKEN');
const PROJECT_ID = process.env.DSH_NODE_ID || 'node-a';

const ROOM_NAME = `dsh-matrix-connector-smoke-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
const POLL_INTERVAL_MS = 1500;

async function http(method, url, body, headers = {}) {
  const init = { method, headers: { ...headers } };
  if (body !== undefined) {
    init.headers['content-type'] = 'application/json';
    init.body = JSON.stringify(body);
  }
  const response = await fetch(url, init);
  const text = await response.text();
  if (!response.ok) {
    throw new Error(`${method} ${url} failed: ${response.status} ${text}`);
  }
  return text ? JSON.parse(text) : undefined;
}

async function matrix(path, body) {
  return http('POST', `${HOMESERVER}${path}`, body, {
    Authorization: `Bearer ${ACCESS_TOKEN}`,
  });
}

function agoraHeaders() {
  return { Authorization: `Bearer ${AGORA_TOKEN}` };
}

async function agoraHealth() {
  return http('GET', `${AGORA}/api/health`, undefined, agoraHeaders());
}

async function agoraCreateTask(input) {
  return http('POST', `${AGORA}/api/tasks`, input, agoraHeaders());
}

async function agoraListCitizens(projectId) {
  return http('GET', `${AGORA}/api/citizens?project_id=${encodeURIComponent(projectId)}`, undefined, agoraHeaders());
}

async function agoraPollEvents(since) {
  return http('GET', `${AGORA}/api/events?since=${encodeURIComponent(String(since))}&project_id=${encodeURIComponent(PROJECT_ID)}`, undefined, agoraHeaders());
}

async function main() {
  console.log('== smoke-matrix v0.1.1 ==');
  console.log('homeserver:', HOMESERVER);
  console.log('user_id   :', USER_ID);
  console.log('agora     :', AGORA);
  console.log('project_id:', PROJECT_ID);

  // 1. agora health
  const h = await agoraHealth();
  console.log('agora health:', h.status);
  assert.equal(h.status, 'ok');

  // 2. citizens list — verifies /api/citizens?project_id= is wired
  // (the running agora central may not have this project yet, so a 404
  // means the route works but the project was never created. We accept
  // either a 200 with an empty array OR a 404 with the standard
  // "Project not found" message.)
  let citizensResp;
  try {
    citizensResp = await agoraListCitizens(PROJECT_ID);
  } catch (err) {
    const text = err instanceof Error ? err.message : String(err);
    if (!/failed: 404/.test(text)) {
      throw err;
    }
    console.log(`citizens route OK (404 for missing project '${PROJECT_ID}')`);
    citizensResp = { citizens: [] };
  }
  console.log(`citizens available: ${citizensResp.citizens?.length ?? 0}`);
  assert.ok(Array.isArray(citizensResp.citizens), 'citizens must be an array');

  // 3. create smoke room. The creator is automatically joined; we do NOT
  // invite USER_ID (which is the same bot) since that would self-invite
  // and fail.
  const room = await matrix('/_matrix/client/v3/createRoom', {
    name: ROOM_NAME,
    topic: 'dsh-matrix-connector smoke',
    preset: 'private_chat',
  });
  console.log('room_id:', room.room_id);

  // 4. dispatch a task via the v0.6.0 schema
  // (no threadKey/target/actor on the wire — those are adapter-side)
  const promptText = `smoke ${new Date().toISOString()}`;
  const taskInput = {
    title: promptText,
    type: 'quick',
    creator: USER_ID,
    description: promptText,
    priority: 'normal',
  };
  const task = await agoraCreateTask(taskInput);
  console.log('agora task:', task.id);
  assert.ok(typeof task.id === 'string' && task.id.length > 0, 'createTask must return id');

  // 5. poll /api/events?since= and verify the events stream is wired
  // (passes if the endpoint returns 200 with the expected shape; whether
  // the new task has produced flow_log entries depends on core state
  // machine behaviour that is outside this smoke's scope.)
  let lastSince = 0;
  let pagesObserved = 0;
  let sawAnyEvent = false;
  for (let attempt = 0; attempt < 6; attempt += 1) {
    await new Promise((resolve) => setTimeout(resolve, POLL_INTERVAL_MS));
    const page = await agoraPollEvents(lastSince);
    pagesObserved += 1;
    lastSince = page.next_since ?? lastSince;
    if (Array.isArray(page.events) && page.events.length > 0) {
      sawAnyEvent = true;
    }
  }
  console.log('event stream pages=', pagesObserved, 'any event=', sawAnyEvent, 'final lastSince=', lastSince);
  assert.equal(typeof lastSince, 'number', '/api/events must return a numeric next_since');

  console.log('OK smoke-matrix passed.');
}

main().catch((err) => {
  if (err instanceof Skipped) {
    console.warn(`SMOKE SKIPPED: ${err.message}`);
    process.exit(0);
  }
  console.error('SMOKE FAILED:', err);
  process.exit(1);
});